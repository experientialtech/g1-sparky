GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Fenrir
# Higher = wilder replies (model default ~1.0)
GEMINI_LIVE_TEMPERATURE=1.2
# Milliseconds of silence before the robot replies (Google recommends 500-800)
GEMINI_LIVE_SILENCE_MS=500
# Seconds between camera frames sent by g1_sparky_vision.py (Gemini accepts <= 1 frame/sec)
IMAGE_SEND_INTERVAL=1.0
