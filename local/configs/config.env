# G1 Sparky - Local Configuration
# All paths relative to repo root: $(dirname $0)/../../

# LLM (Gemma 4 E2B via llama.cpp)
LLM_MODEL=local/models/gemma-4-E2B-it-Q4_K_M.gguf
LLM_MMPROJ=local/models/gemma4-mmproj-F16.gguf
LLM_PORT=8860
LLM_GPU_LAYERS=99
LLM_CTX_SIZE=4096
LLM_THREADS=12

# ASR (whisper.cpp)
ASR_MODEL=local/models/ggml-tiny.en.bin
ASR_PORT=8080

# TTS (piper)
TTS_ENGINE=piper
PIPER_CMD=/opt/piper/piper
PIPER_MODEL=local/models/en_US-amy-low.onnx

# Camera
CAMERA_DEVICE=/dev/video6

# Audio
MIC_DEVICE=default_mic_aec
SPEAKER_DEVICE=default_output_aec

# Conversation
SILENCE_THRESHOLD=300
MAX_TOKENS=200
LLM_TIMEOUT=60
